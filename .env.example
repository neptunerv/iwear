# Public site URL (used for metadata, sitemap, canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WhatsApp deep link or bare international number
# Examples: https://wa.me/6281234567890  |  6281234567890
# When unset, messaging CTAs use Instagram DM instead.
# NEXT_PUBLIC_WHATSAPP_URL=

# Optional: GA4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your_storefront_public_token
# Optional private token fallback (prefer public token above)
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# New Customer Accounts (Customer Account API / OAuth)
# From Shopify Admin → Sales channels → Headless → Customer Account API
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Optional if you created a confidential client:
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Callback URL to add in Headless settings:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/callback
# Logout URL:
#   {NEXT_PUBLIC_SITE_URL}/account
# Localhost is NOT allowed — use ngrok or a deployed HTTPS URL for testing.

# Storefront API scopes (custom app):
# - unauthenticated_read_product_listings
# - unauthenticated_read_product_inventory
# - unauthenticated_write_checkouts

# Optional Admin API — image upload script only
# SHOPIFY_STORE_URL=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...
